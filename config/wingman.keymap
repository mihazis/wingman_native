#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_de.h"	
#include <dt-bindings/zmk/outputs.h>  

#define DEF 0
#define LWR 1
#define RSE 2
#define CSM 3
#define GAM 4
#define ADJ 5


&lt {
    tapping-term-ms = <300>;
};

/ {
        behaviors {
            esc_ctrl: esc_ctrl {
                compatible = "zmk,behavior-hold-tap";
                label = "ESC_CTRL";
                #binding-cells = <2>;
                tapping-term-ms = <300>;  
                quick-tap-ms = <120>;      
                flavor = "tap-preferred";   
                global-quick-tap;
                bindings = <&kp>, <&kp>;  
            };

        };

    
        combos {
            compatible = "zmk,combos";
    
            fourth_layer_combo {
                key-positions = <37 40>;  
                timeout-ms = <50>;         
                layers = <0>;               
                bindings = <&mo 3>;         
            };
        };


        keymap {
                compatible = "zmk,keymap";
	
                default_layer {
                        // -----------------------------------------------------------------------------------------
                        // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
                        // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
                        // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
                        //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
                            &kp ESC          &kp Q         &kp W         &kp E         &kp R         &kp T                            &kp Y         &kp U          &kp I       &kp O          &kp P        &kp LBKT
                            &kp LGUI         &kp A         &kp S         &kp D         &kp F         &kp G                            &kp H         &kp J          &kp K       &kp L         &kp SEMI      &kp SQT
                            &kp LCTRL        &kp Z         &kp X         &kp C         &kp V         &kp B                            &kp N         &kp M        &kp COMMA    &kp DOT        &kp FSLH        &kp FSLH           
                                                                        &kp LSHFT     &kp SPACE      &mo RSE                          &mo LWR       &kp BSPC      &kp RSHFT
                        >;
                };
                lower_layer {
                        // -----------------------------------------------------------------------------------------
                        // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
                        // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
                        // | SHFT |     |     | Prev| Pau | Next|   |  ö  |  ä   |  ü  |  ß  |     |      |
                        //                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
                        &kp TILDE     &kp LPAR      &kp RPAR       &kp F4       &kp DLLR      &kp CARET                         &kp EXCL      &kp AT       &kp SQT       &kp LBKT      &kp RBKT      &kp LS(FSLH)  
                        &kp EQUAL      &kp N1        &kp N2        &kp N3        &kp N4        &kp N5                           &kp N6        &kp N7        &kp N8        &kp N9        &kp N0       &kp RA(F)
                        &kp PLUS       &kp EXCL      &kp AT       &kp HASH      &kp DLLR      &kp PRCNT                         &kp CARET     &kp AMPS      &kp STAR      &kp LPAR      &kp RPAR      &kp RA(G)
                                                                   &lt ADJ TAB    &trans        &mo CSM                           &trans        &trans      &lt ADJ DEL
                         >;
                };

                raise_layer {
                        // -----------------------------------------------------------------------------------------
                        // |  TAB |  !  |  "  |  §  |  $  |  %  |   |  &  |  /  |  (  |  )  |  =  | BKSP |
                        // | CTRL |     |  '  |  €  |  ^  |  @  |   |  \  |  ` |  {  |  }  |  #  |  <   |
                        // | SHFT |     |     |     |  <  |  >  |   |  ?  |  +  |  [  |  ]  | "|" |  >   |
                        //                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
                        &kp LA(TAB)    &kp LEFT      &kp ENTER     &kp RIGHT    &kp LA(N4)    &kp MINUS                          &kp INS      &kp BSPC       &kp DEL      &kp PG_UP     &kp LC(LS(P)) &kp LC(LS(X))
                        &kp LC(LA(TAB))  &kp LC(A)     &kp PIPE      &kp TAB      &kp LA(F)     &kp LS(FSLH)                       &kp LEFT     &kp DOWN       &kp UP       &kp RIGHT     &kp LS(SEMI)  &kp LC(LS(O))
                        &kp DEL      &kp GRAVE     &kp LG(X)     &kp LC(INS)  &kp LS(INS)   &kp LA(LSHFT)                       &kp HOME     &kp PG_DN      &kp PG_UP     &kp END     &kp LC(LA(M)) &kp LC(LA(F))
                                                                         &lt ADJ RET    &trans         &trans                          &mo CSM      &kp ENTER      &kp LS(ENTER)
                        >;
                };

                function_layer{
                        // -----------------------------------------------------------------------------------------
                        // | TAB  |  F1   |  F2    |  F3   |   F4  | F5    |     |     |     |     |     |     | BKSP |
                        // | CTRL |  F6   |  F7    |  F8   |   F9  |  F10  |     |     |     |     |     |     |      |
                        // | SHFT |  F11  |  F12   |  F13  |       |       |     |     |     |     |     |     |      |
                        //                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
                            &esc_ctrl LCTRL TAB &kp F1  &kp F2  &kp F3  &kp F4  &kp F5       &trans &trans &trans &trans &trans &kp BSPC
                            &kp ESC &kp F6  &kp F7  &kp F8  &kp F9  &kp F10      &trans &trans &trans &trans &trans &trans
                            &kp LSHFT &kp F11 &kp F12 &kp F13 &trans  &trans       &trans &trans &trans &trans &trans &trans
                                                      &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;

                };
        };
};
